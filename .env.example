# Copy this file to .env, chmod 600 .env, and fill in every value, then run
# ./Scripts/setup-release-secrets.sh. Do not commit real credentials.
# Values must fit on one line. Single or double quotes are optional and stripped;
# $ and backslashes stay literal. Use whole-line comments, not inline comments.

# base64 < certificate.p12 | tr -d '\n'   (Developer ID Application cert + private key)
MACOS_CERTIFICATE_P12=
# The password used when exporting the .p12.
MACOS_CERTIFICATE_PASSWORD=
# e.g. 'Developer ID Application: Your Name (TEAMID)'
MACOS_SIGNING_IDENTITY=

# App Store Connect API key used by notarytool.
NOTARY_API_KEY_ID=
NOTARY_API_ISSUER_ID=
# Base64 content, not a local path: base64 < AuthKey_KEYID.p8 | tr -d '\n'
NOTARY_API_KEY_P8=
